# Copy to .env (gitignored) and fill in. Never commit .env.

# Required. Use a long random value.
POSTGRES_PASSWORD=

# Local model (see docs/00-architecture.md section 6).
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_S=60

# Frontend exposure. Keep 127.0.0.1 unless you understand the LAN risk.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000

# Upload limits and worker (optional; these are the defaults).
MAX_UPLOAD_MB=25
MAX_PAGES=300
JOB_TIMEOUT_S=120

# false: delete the stored PDF after successful processing (recommended).
# true: keep every statement file (needed while building/testing extraction).
RETAIN_DOCUMENTS=false

# Set to true only when served over HTTPS.
COOKIE_SECURE=false
